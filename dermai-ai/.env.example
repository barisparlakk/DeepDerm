# DermAI environment variables
# Copy this to .env and fill in your values.

# ── Database ──────────────────────────────────────────────────────────────────
# Must use asyncpg driver prefix (not jdbc:postgresql://)
DEEPDERM_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/deepderm

# ── Model ─────────────────────────────────────────────────────────────────────
# Path to YOLO weights file. Default downloads yolo11n.pt (COCO) on first run.
# Replace with your trained acne detector weights once available.
DERMAI_MODEL_PATH=yolo11n.pt
DERMAI_MODEL_VERSION=yolo11n-prototype

# Detection thresholds (0.0 – 1.0)
DERMAI_CONF_THRESHOLD=0.25
DERMAI_IOU_THRESHOLD=0.45

# If true and DERMAI_MODEL_PATH points to default yolo11n.pt,
# DermAI uses deterministic image-based lesion candidate detection.
DERMAI_HEURISTIC_FALLBACK=true

# ── Storage ────────────────────────────────────────────────────────────────────
STORAGE_DIR=storage/annotated

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (Spring Boot + dev frontend)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
